{
  "openapi": "3.1.0",
  "info": {
    "title": "LocalPilot Inference Gateway API",
    "version": "0.1.9",
    "description": "Authenticated, loopback-only OpenAI-compatible inference gateway for local models.",
    "license": {
      "name": "GPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local loopback server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Gateway health status",
        "responses": {
          "200": {
            "description": "Gateway status ok"
          }
        }
      }
    },
    "/v1/health/live": {
      "get": {
        "summary": "Liveness probe verifying gateway process is alive",
        "responses": {
          "200": {
            "description": "Gateway process is alive"
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "summary": "Readiness probe verifying models and execution readiness",
        "responses": {
          "200": {
            "description": "At least one model version is ready for inference"
          },
          "503": {
            "description": "No model version or alias is ready for inference"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI 3.1.0 specification",
        "responses": {
          "200": {
            "description": "OpenAPI JSON document"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List available models and aliases authorized for the API key",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of authorized models"
          },
          "401": {
            "description": "Missing or invalid API key"
          }
        }
      }
    },
    "/v1/models/{model_id}": {
      "get": {
        "summary": "Retrieve specific model or alias information",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model information"
          },
          "404": {
            "description": "Model not found"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Execute chat completion with or without streaming",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model alias or name"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "system",
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "default": 0.7
                  },
                  "top_p": {
                    "type": "number",
                    "default": 0.95
                  },
                  "max_tokens": {
                    "type": "integer"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response or SSE stream"
          },
          "400": {
            "description": "Bad request or missing required parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Model not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Local API Key (sk-local-...)"
      }
    }
  }
}